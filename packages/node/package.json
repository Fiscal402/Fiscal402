{
  "name": "@fiscal402/node",
  "version": "0.1.0",
  "description": "Server-side Fiscal402 Node.js client. Process settled machine payments into verifiable fiscal events.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "@fiscal402/sdk": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "homepage": "https://www.fiscal402.com",
  "bugs": {
    "url": "https://github.com/Fiscal402/Fiscal402/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fiscal402/Fiscal402.git",
    "directory": "packages/node"
  },
  "keywords": [
    "fiscal402",
    "x402",
    "vat",
    "eu-vat",
    "agentic-commerce",
    "machine-payments",
    "fiscal-receipt",
    "ubl",
    "en16931"
  ]
}
