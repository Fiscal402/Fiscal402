{
  "name": "@fiscal402/verify",
  "version": "1.1.0",
  "private": true,
  "description": "Independent verifier for fiscal402.receipt/1.0.0 and fiscal402.receipt/2.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fiscal402-verify": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --experimental-strip-types --test test/verify.test.ts test/verify-v2.test.ts test/conformance.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.9.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fiscal402/Fiscal402.git",
    "directory": "packages/verify"
  },
  "keywords": ["fiscal402", "receipt", "verification", "ed25519"]
}
